# ==============================================================================
# Faculty of Information Technology, Roi Et Rajabhat University (RERU)
# Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit the actual '.env' file containing real production secrets!
# Copy this file to '.env' and adjust settings for your deployment.

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
SESSION_COOKIE_NAME=reru_secure_session
SESSION_LIFETIME_SECONDS=3600

# Cookie Security (Set to True in HTTPS production)
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=Lax

# Database Settings
DATABASE_PATH=data/reru_admissions.db

# Private Storage Settings (Outside of public web root)
STORAGE_DIR=storage/private_documents

# Rate Limiting & Protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
